<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) 専用 Launch テーマ。
  OS 強制適用の SplashScreen API を回避できないので、
  windowSplashScreenAnimatedIcon に透明 vector drawable を指定して
  「ロゴ無し・#1A1F2E 一色」のスプラッシュにする。
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 背景色: capacitor.config.ts の SURFACE と一致させる -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- 中央に出るアイコンを透明 drawable で実質非表示にする -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <!-- Activity 起動後に適用される post-splash テーマ -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
