# ============================================================
# Logic App — ローカル開発用 .env サンプル
#
# このファイルをコピーして .env にリネームし、
# 各値を実際のキーに差し替えてください。
# 実際のキーは Keita さんの 1Password / Render ダッシュボードで確認。
# ============================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://yctlelmlwjwlcpcxvmgx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://yctlelmlwjwlcpcxvmgx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Feature flags ---
# Device Sync Phase 1 (フラッシュカード / 誤答 / saved items / notebook / roadmap /
# カテゴリ別 progress を Supabase に同期して別端末で引き継ぐ)
# デフォルト false。内部テスター環境のみ true で dry-run する。
# Phase 3 では /api/feature-flags/device-sync 経由でサーバー側ロールアウト判定が優先される。
# この env=true はサーバー判定を上書きして強制 ON にする内部テスター向け override。
VITE_ENABLE_DEVICE_SYNC=false

# AF-06 レッスン/コース画像のオンデマンド(リモート)読込。デフォルト OFF。
# 'on' のとき、かつ VITE_LESSON_ASSET_BASE_URL が設定されているときだけ、
# bundled の /images/v3/*.png をリモート URL (Supabase Storage 公開バケット) に
# 差し替える。未設定 or off では従来どおり bundled パスをそのまま使う(挙動不変)。
# 対象は PNG のみ。ロードマップ一覧の軽量 .webp は同梱維持(設計どおり素通し)。
# 本番 Storage には全 v3 PNG(222枚) を public バケット lesson-assets に
# フラット配置(basename キー)でアップロード済み(2026-06-01)。
# 本番でフラグ ON にする = 全ユーザーが画像を Storage から取得する挙動変更のため
# Keita 承認が必要。検証用にローカルでのみ on にする。
VITE_REMOTE_LESSON_ASSETS=off
# 公開バケット lesson-assets の base URL(末尾スラッシュ無し):
# https://yctlelmlwjwlcpcxvmgx.supabase.co/storage/v1/object/public/lesson-assets
VITE_LESSON_ASSET_BASE_URL=

# Device Sync Phase 3 段階公開: 0〜100 の整数で指定。0=全員 OFF、100=全員 ON。
# /api/feature-flags/device-sync が userId ハッシュバケット (0-99) と比較して
# bucket < rolloutPct のときに enabled: true を返す。同一 userId は常に同じ判定。
# 公開計画: 25 → 50 → 100% を各 1 週間ずつ観察してから次の段階に進める。
DEVICE_SYNC_ROLLOUT_PCT=0

# Device Sync Phase 3: rolloutPct を無視して常に enabled: true を返す userId のカンマ区切りリスト。
# Phase 2 の内部テスター (Keita / QA 担当の Supabase user uuid) を入れておく。
# 例: DEVICE_SYNC_FORCE_USER_IDS=00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002
DEVICE_SYNC_FORCE_USER_IDS=

# --- Stripe (テストモード) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# 旧Price IDs（後方互換用）
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# 新Price IDs（Standard / Premium）
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_STANDARD_YEARLY=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...

# --- Anthropic (AI問題生成) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Gemini (コース／レッスン画像生成) ---
# scripts/generate-course-images.ts で使用
GEMINI_API_KEY=AIza...

# --- Google Cloud Text-to-Speech (レッスン読み上げのクラウド音声) ---
# /api/tts proxy で使用。未設定なら端末(native)/Web TTS にフォールバックする（オフライン維持）。
GOOGLE_TTS_API_KEY=
# 1 日あたり合成文字数の上限（サーキットブレーカー）。未設定で 50 万文字/日。
# 上限到達時は 503 を返しクライアントは端末 TTS にフォールバック（無音にはならない）。
TTS_DAILY_CHAR_LIMIT=

# --- Jira ---
JIRA_URL=https://logic.atlassian.net
JIRA_EMAIL=keita.urano@gmail.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SCRUM

# --- メール通知 ---
REPORT_EMAIL_TO=keita.urano2@gmail.com

# --- Admin ---
ADMIN_SECRET=logic-admin-2026

# --- ローカル開発用 API URL ---
# ローカルでサーバーを起動する場合
VITE_API_BASE=http://localhost:3000
# SITを参照する場合はコメントアウトを外す
# VITE_API_BASE=https://logic-sit.onrender.com

# --- Sentry (クラッシュレポート) ---
# Sentry ダッシュボードで作成した DSN を貼る。未設定なら no-op
VITE_SENTRY_DSN=
# リリース識別用。CI でビルド時に Git SHA や semver を渡すと Sentry に release が表示される
VITE_APP_VERSION=
